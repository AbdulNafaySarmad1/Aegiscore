AEGISCORE_DB_CONNECTION=Host=postgres;Port=5432;Database=aegiscore;Username=aegiscore;Password=aegiscore-local;SslMode=Disable
AEGISCORE_REDIS_CONNECTION=redis:6379
AEGISCORE_STORAGE_PROVIDER=local
AEGISCORE_STORAGE_LOCAL_PATH=/app/storage
AEGISCORE_LICENSE_SERVER_URL=https://license.aegiscore.systems
AEGISCORE_ENCRYPTION_KEY=base64-32-byte-key
AEGISCORE_PQC_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AEGISCORE_JWT_SECRET=replace-with-strong-jwt-secret
Governance__FeedbackEncryptionKeyBase64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ASPNETCORE_URLS=http://+:8080
AEGISCORE_INSTALLATION_COMPLETED=true
Database__AutoMigrate=true
POSTGRES_DB=aegiscore
POSTGRES_USER=aegiscore
POSTGRES_PASSWORD=aegiscore-local
