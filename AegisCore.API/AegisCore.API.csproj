<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Authentication & Cryptography -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    
    <!-- Data Access -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    
    <!-- Serialisation -->
    <!-- HTTP & Networking -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
    
    <!-- Casbin ABAC -->
    <PackageReference Include="Casbin.NET" Version="2.21.3" />
    
    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    
    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    
    <!-- Rate Limiting -->
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    
    <!-- ProblemDetails -->
    <PackageReference Include="Hellang.Middleware.ProblemDetails" Version="6.5.1" />
    
    <!-- CVE-2024-43485: Force safe version of System.Text.Encodings.Web -->
    <!-- CVE-2024-21319: Force safe version of Microsoft.IdentityModel.Tokens -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AegisCore.Application\AegisCore.Application.csproj" />
    <ProjectReference Include="..\AegisCore.Migrations.MySql\AegisCore.Migrations.MySql.csproj" />
    <ProjectReference Include="..\AegisCore.Migrations.MsSql\AegisCore.Migrations.MsSql.csproj" />
    <ProjectReference Include="..\AegisCore.Migrations.Oracle\AegisCore.Migrations.Oracle.csproj" />
    <ProjectReference Include="..\AegisCore.Infrastructure\AegisCore.Infrastructure.csproj" />
    <ProjectReference Include="..\AegisCore.Domain\AegisCore.Domain.csproj" />
    <ProjectReference Include="..\AegisCore.Contracts\AegisCore.Contracts.csproj" />
  </ItemGroup>

</Project>
