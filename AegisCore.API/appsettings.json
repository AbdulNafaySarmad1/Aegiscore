{
  "Pqc": {
    "DeadKeyDays": 30,
    "Rotation": {
      "CustodianRole": "Super Admin",
      "RequiredApprovals": 2,
      "ValidForHours": 168,
      "SigningLeadDays": 14,
      "ArchivalLeadDays": 90
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AegisCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://aegiscore.university.edu.pk",
    "https://*.azurewebsites.net"
  ],
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5001"
    ]
  },
  "Auth": {
    "Authority": "",
    "Audience": "aegiscore-api"
  },
  "License": {
    "HmacSecret": "",
    "HeartbeatUrl": "",
    "HeartbeatTimeoutSeconds": "10",
    "HeartbeatServerToken": ""
  },
  "Admissions": {
    "TrackingTokenSecret": ""
  },
  "AI": {
