{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "AegisCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "${SUPABASE_URL}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "Cors": {
    "AllowedOrigins": ["${AEGISCORE_FRONTEND_URL}"]
  },
  "Auth": {
    "Authority": "${JWT_AUTHORITY}",
    "Audience": "${JWT_AUDIENCE}"
  },
  "License": {
    "HmacSecret": "${LICENSE_HMAC_SECRET}",
    "HeartbeatUrl": "${LICENSE_HEARTBEAT_URL}",
    "HeartbeatTimeoutSeconds": "10",
    "HeartbeatServerToken": "${LICENSE_HEARTBEAT_SERVER_TOKEN}"
  },
  "Admissions": {
    "TrackingTokenSecret": "${ADMISSIONS_TRACKING_TOKEN_SECRET}"
  },
  "AI": {
    "Provider": "${AI_PROVIDER}",
    "OpenAI": {
      "ApiKey": "${AI_OPENAI_API_KEY}",
      "BaseUrl": "${AI_OPENAI_BASE_URL}",
      "Model": "${AI_OPENAI_MODEL}",
      "EmbeddingModel": "${AI_EMBEDDING_MODEL}"
    },
    "Ollama": {
      "BaseUrl": "${AI_OLLAMA_BASE_URL}",
      "Model": "${AI_OLLAMA_MODEL}",
      "EmbeddingModel": "${AI_OLLAMA_EMBEDDING_MODEL}"
    }
  },
  "Search": {
    "ElasticsearchUrl": "${ELASTICSEARCH_URL}",
    "IndexPrefix": "aegiscore"
  },
  "Email": {
    "SmtpHost": "${SMTP_HOST}",
    "SmtpPort": "${SMTP_PORT}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "EnableSsl": "true",
    "FromAddress": "${EMAIL_FROM_ADDRESS}",
    "FromName": "${EMAIL_FROM_NAME}"
  },
  "Twilio": {
    "AccountSid": "${TWILIO_ACCOUNT_SID}",
    "AuthToken": "${TWILIO_AUTH_TOKEN}",
    "FromNumber": "${TWILIO_FROM_NUMBER}"
  },
  "WhatsApp": {
    "AccessToken": "${WHATSAPP_ACCESS_TOKEN}",
    "PhoneNumberId": "${WHATSAPP_PHONE_NUMBER_ID}"
  },
  "KeyVault": {
    "VaultUri": ""
  },
  "Raast": {
    "BaseUrl": "${RAAST_BASE_URL}",
    "ApiKey": "${RAAST_API_KEY}"
  },
  "Identity": {
    "Saml": {
      "BaseUrl": "${AEGISCORE_API_URL}"
    }
  },
  "Postgres": {
    "ConnectionString": "${SUPABASE_URL}"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}"
  },
  "PaymentGateways": {
    "raast": { "BaseUrl": "${RAAST_BASE_URL}" },
    "stripe": { "BaseUrl": "${STRIPE_BASE_URL}" },
    "plaid-ach": { "BaseUrl": "${PLAID_BASE_URL}" },
    "gocardless": { "BaseUrl": "${GOCARDLESS_BASE_URL}" },
    "billplz-fpx": { "BaseUrl": "${BILLPLZ_BASE_URL}" },
    "duitnow-qr": { "BaseUrl": "${DUITNOW_BASE_URL}" }
  }
}
