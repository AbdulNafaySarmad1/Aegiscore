{
  "name": "aegiscore-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "capture:screenshots": "node tests/capture/run-capture.mjs screenshots",
    "capture:demo": "node tests/capture/run-capture.mjs demo",
    "capture:lifecycle": "node tests/capture/run-capture.mjs lifecycle",
    "capture:install": "node tests/capture/run-capture.mjs install",
    "capture:visual-demo": "node tests/capture/run-capture.mjs visual-demo",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "AXE_SCOPE=all playwright test tests/accessibility.spec.ts",
    "test:a11y:ci": "AXE_SCOPE=high-risk playwright test tests/accessibility.spec.ts",
    "test:keyboard": "playwright test tests/keyboard-accessibility.spec.ts",
    "test:accessibility:ci": "npm run test:a11y:ci && npm run test:keyboard"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@noble/post-quantum": "^0.6.1",
    "@react-pdf/renderer": "^4.9.0",
    "@swc/helpers": "0.5.23",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "next-intl": "^4.13.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
