@page "/"
@namespace AegisCore.Setup.Pages
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>AegisCore Setup</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col shrink-0">
            <div class="px-6 py-6 border-b border-slate-800">
                <h1 class="text-lg font-bold tracking-tight">◆ AegisCore</h1>
                <p class="text-xs text-slate-500 mt-1">Setup Wizard</p>
            </div>
            <nav class="flex-1 py-4 space-y-1">
                @foreach (var step in Steps)
                {
                    var isActive = step.Number == CurrentStep;
                    var isDone = step.Number < CurrentStep;
                    <div class="flex items-center gap-3 px-4 py-2.5 text-sm @(isActive ? "text-white font-semibold bg-blue-600/10 border-r-2 border-blue-500" : isDone ? "text-emerald-400" : "text-slate-500")">
                        <span class="w-5 h-5 rounded-full @(isDone ? "bg-emerald-500/20" : isActive ? "bg-blue-500/20" : "border border-slate-700") flex items-center justify-center text-xs">
                            @(isDone ? "✓" : isActive ? "●" : "")
                        </span>
                        @step.Label
                    </div>
                }
            </nav>
            <div class="px-4 py-4 border-t border-slate-800 text-xs text-slate-600">Apex Systems</div>
        </aside>

        <!-- Content -->
        <main class="flex-1 flex items-center justify-center p-8">
            <div class="w-full max-w-lg">
                <!-- Progress -->
                <div class="flex items-center justify-between mb-8">
                    <span class="text-sm text-slate-400">Step @CurrentStep of @Steps.Count</span>
                    <div class="w-32 h-1.5 bg-slate-700 rounded-full">
                        <div class="h-1.5 bg-blue-500 rounded-full transition-all" style="width: @(CurrentStep * 100 / Steps.Count)%"></div>
                    </div>
                </div>

                <!-- Step content -->
                <div class="bg-slate-800 border border-slate-700 rounded-xl p-6">
                    @switch (CurrentStep)
                    {
                        case 1:
                            <Step1License @bind-LicenseKey="LicenseKey" OnValidate="OnValidateLicense" IsValidating="IsValidating" ValidationResult="LicenseResult" />
                            break;
                        case 3:
                            <Step3Postgres OnTest="OnTestPostgres" IsTesting="IsTesting" TestResult="PgResult" />
                            break;
                        case 4:
                            <Step4Redis OnTest="OnTestRedis" IsTesting="IsTesting" TestResult="RedisResult" />
                            break;
                        case 9:
                            <Step9Domain OnProvision="OnProvisionDomain" OnCheckDns="OnCheckDns" DnsResult="DnsResult" />
                            break;
                        case 11:
                            <Step11GoLive OnGoLive="OnGoLive" GoLiveResult="GoLiveResult" />
                            break;
                        default:
                            <div class="text-center text-slate-400"><p class="text-xl mb-2">◆</p><p>Select a step from the sidebar.</p></div>
                            break;
                    }
                </div>

                <!-- Navigation -->
                @if (CurrentStep > 1)
                {
                    <div class="flex gap-3 mt-6">
                        @if (CurrentStep > 1)
                        {
                            <button @onclick="() => CurrentStep = Math.Max(1, CurrentStep - 1)"
                                    class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium rounded-lg transition">
                                ← Back
                            </button>
                        }
                    </div>
                }
            </div>
        </main>
    </div>
</div>

@code {
    int CurrentStep = 1;
    string LicenseKey = "";
    bool IsValidating;
    LicenseValidationResult? LicenseResult;
    ConnectionTestResult? PgResult;
    ConnectionTestResult? RedisResult;
    bool IsTesting;
    DnsPropagationResult? DnsResult;
    GoLiveResult? GoLiveResult;

    record StepInfo(int Number, string Label);
    List<StepInfo> Steps = new()
    {
        new(1, "License"), new(2, "Identity"), new(3, "PostgreSQL"),
        new(4, "Redis"), new(5, "File Storage"), new(6, "Secrets"),
        new(7, "Email"), new(8, "SMS"), new(9, "Domain"),
        new(10, "Admin Account"), new(11, "Go Live")
    };

    async Task OnValidateLicense() { IsValidating = true; await Task.Delay(500); IsValidating = false; LicenseResult = new LicenseValidationResult(true, new LicenseDto("KEY", "Enterprise", "SSUET", DateTime.UtcNow.AddYears(1), 10000, 3)); CurrentStep = 3; }
    async Task OnTestPostgres() { IsTesting = true; await Task.Delay(800); IsTesting = false; PgResult = new ConnectionTestResult(true, "PostgreSQL 16.2 — 12ms"); CurrentStep = 4; }
    async Task OnTestRedis() { IsTesting = true; await Task.Delay(500); IsTesting = false; RedisResult = new ConnectionTestResult(true, "Redis 7.2 — read/write verified"); CurrentStep = 9; }
    async Task OnProvisionDomain() { await Task.Delay(300); DnsResult = new DnsPropagationResult(true, 100, "DNS ready."); }
    async Task OnCheckDns() { await Task.Delay(600); DnsResult = new DnsPropagationResult(true, 100, "DNS propagated."); }
    async Task OnGoLive() { await Task.Delay(1500); GoLiveResult = new GoLiveResult(true, "https://erp.ssuet.edu.pk", Checks: new()); }
}
