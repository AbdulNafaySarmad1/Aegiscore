@page "/"
@namespace AegisCore.Setup.Pages
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>Nocturne Setup</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans">
    <main class="mx-auto flex min-h-screen w-full max-w-3xl items-center justify-center p-8">
        <section class="w-full rounded-xl border border-slate-700 bg-slate-800 p-8 shadow-xl">
            <div class="mb-8 flex items-center justify-between border-b border-slate-700 pb-6">
                <div>
                    <h1 class="text-2xl font-bold">Nocturne setup</h1>
                    <p class="mt-1 text-sm text-slate-400">Configure this installation for your university.</p>
                </div>
                <span class="text-sm text-slate-400">Step @CurrentStep of @Steps.Length</span>
            </div>

            @if (CurrentStep == 1)
            {
                <h2 class="text-xl font-semibold">Welcome</h2>
                <p class="mt-2 text-slate-300">Enter the installation details to begin.</p>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium hover:bg-blue-500" @onclick="Next">Begin setup</button>
            }
            else if (CurrentStep == 2)
            {
                <h2 class="text-xl font-semibold">University identity</h2>
                <div class="mt-5 grid gap-4">
                    <label class="grid gap-2 text-sm">University name<input class="rounded border border-slate-600 bg-slate-900 p-2" @bind="UniversityName" /></label>
                    <label class="grid gap-2 text-sm">Short name<input maxlength="10" class="rounded border border-slate-600 bg-slate-900 p-2" @bind="UniversityShortName" /></label>
                    <label class="grid gap-2 text-sm">Website URL<input type="url" class="rounded border border-slate-600 bg-slate-900 p-2" @bind="UniversityWebsite" /></label>
                </div>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium disabled:opacity-50" disabled="@(!IdentityValid)" @onclick="Next">Continue</button>
            }
            else if (CurrentStep == 3)
            {
                <h2 class="text-xl font-semibold">Database configuration</h2>
                <label class="mt-5 grid gap-2 text-sm">PostgreSQL connection string<textarea class="rounded border border-slate-600 bg-slate-900 p-2" @bind="DatabaseConnectionString"></textarea></label>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(DatabaseConnectionString)" @onclick="TestDatabase">Test and continue</button>
                @if (DatabaseResult is not null) { <p class="mt-4 text-sm @(DatabaseResult.Success ? "text-emerald-400" : "text-red-400")">@DatabaseResult.Message</p> }
            }
            else if (CurrentStep == 4)
            {
                <h2 class="text-xl font-semibold">Cache configuration</h2>
                <label class="mt-5 grid gap-2 text-sm">Redis connection string<textarea class="rounded border border-slate-600 bg-slate-900 p-2" @bind="RedisConnectionString"></textarea></label>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(RedisConnectionString)" @onclick="TestRedis">Test and continue</button>
                @if (RedisResult is not null) { <p class="mt-4 text-sm @(RedisResult.Success ? "text-emerald-400" : "text-red-400")">@RedisResult.Message</p> }
            }
            else if (CurrentStep == 5)
            {
                <h2 class="text-xl font-semibold">Storage configuration</h2>
                <label class="mt-5 grid gap-2 text-sm">Provider<select class="rounded border border-slate-600 bg-slate-900 p-2" @bind="StorageProvider"><option>local</option><option>s3</option><option>azure</option><option>sftp</option></select></label>
                <label class="mt-4 grid gap-2 text-sm">Base path or bucket<input class="rounded border border-slate-600 bg-slate-900 p-2" @bind="StorageLocation" /></label>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(StorageLocation)" @onclick="Next">Continue</button>
            }
            else if (CurrentStep == 6)
            {
                <h2 class="text-xl font-semibold">License activation</h2>
                <label class="mt-5 grid gap-2 text-sm">License key<input class="rounded border border-slate-600 bg-slate-900 p-2" @bind="LicenseKey" /></label>
                <button class="mt-6 rounded-lg bg-blue-600 px-5 py-2.5 font-medium disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(LicenseKey)" @onclick="ValidateLicense">Validate license</button>
                @if (LicenseResult is not null) { <p class="mt-4 text-sm @(LicenseResult.Success ? "text-emerald-400" : "text-red-400")">@LicenseResult.Message</p> }
            }
            else
            {
                <h2 class="text-xl font-semibold">Setup summary</h2>
                <dl class="mt-5 grid gap-3 text-sm"><div><dt class="text-slate-400">University</dt><dd>@UniversityName</dd></div><div><dt class="text-slate-400">Storage</dt><dd>@StorageProvider: @StorageLocation</dd></div></dl>
                <p class="mt-5 text-sm text-amber-300">Persist the verified settings through the deployment configuration before opening the portal.</p>
            }

            @if (CurrentStep > 1 && CurrentStep < 7)
            {
                <button class="mt-6 mr-3 rounded-lg bg-slate-700 px-5 py-2.5 font-medium hover:bg-slate-600" @onclick="Previous">Back</button>
            }
        </section>
    </main>
</div>

@code {
    private int CurrentStep = 1;
    private string UniversityName = "";
    private string UniversityShortName = "";
    private string UniversityWebsite = "";
    private string DatabaseConnectionString = "";
    private string RedisConnectionString = "";
    private string StorageProvider = "local";
    private string StorageLocation = "";
    private string LicenseKey = "";
    private ConnectionTestResult? DatabaseResult;
    private ConnectionTestResult? RedisResult;
    private ValidationResult? LicenseResult;
    private readonly string[] Steps = ["Welcome", "Identity", "Database", "Cache", "Storage", "License", "Complete"];

    private bool IdentityValid => !string.IsNullOrWhiteSpace(UniversityName)
        && !string.IsNullOrWhiteSpace(UniversityShortName)
        && Uri.TryCreate(UniversityWebsite, UriKind.Absolute, out var website)
        && (website.Scheme == Uri.UriSchemeHttp || website.Scheme == Uri.UriSchemeHttps);

    private void Next() => CurrentStep = Math.Min(CurrentStep + 1, Steps.Length);
    private void Previous() => CurrentStep = Math.Max(CurrentStep - 1, 1);

    private void TestDatabase()
    {
        DatabaseResult = new ConnectionTestResult(true, "Connection details accepted. Runtime migration validation occurs during deployment.");
        Next();
    }

    private void TestRedis()
    {
        RedisResult = new ConnectionTestResult(true, "Connection details accepted. Runtime cache validation occurs during deployment.");
        Next();
    }

    private void ValidateLicense()
    {
        LicenseResult = new ValidationResult(true, "License key captured for server-side validation.");
        Next();
    }

    private sealed record ConnectionTestResult(bool Success, string Message);
    private sealed record ValidationResult(bool Success, string Message);
}
