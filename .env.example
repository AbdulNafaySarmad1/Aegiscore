# Generate a real local .env with: ./scripts/bootstrap-env.sh
AEGISCORE_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
AEGISCORE_DEMO_MODE=true
AEGISCORE_SECRET_PROVIDER=FILE
# Live deployments use INFISICAL and must configure INFISICAL_URL, INFISICAL_TOKEN,
# INFISICAL_WORKSPACE_ID, and INFISICAL_ENVIRONMENT.
AEGISCORE_INSTALLATION_COMPLETED=false
TENANT_ID=

# Optional prebuilt images. Leave unset to build from source.
# AEGISCORE_API_IMAGE=ghcr.io/abdulnafaysarmad1/aegiscore-api:recovery-latest
# AEGISCORE_PORTAL_IMAGE=ghcr.io/abdulnafaysarmad1/aegiscore-portal:recovery-latest

POSTGRES_DB=aegiscore
POSTGRES_USER=aegiscore
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=aegiscore_admin
POSTGRES_ADMIN_PASSWORD=
REDIS_PASSWORD=

LICENSE_SERVER_URL=https://license.aegiscore.systems
LICENSE_HMAC_SECRET=
AEGISCORE_ENCRYPTION_KEY=
AEGISCORE_PQC_KEY_BASE64=
AEGISCORE_JWT_SECRET=
GOVERNANCE_FEEDBACK_KEY_BASE64=
AEGISCORE_REQUIRE_EDGE_PQC=false
AEGISCORE_EDGE_PQC_PROOF_KEY_BASE64=
AEGISCORE_DATA_PROTECTION_CERTIFICATE_PATH=
AEGISCORE_DATA_PROTECTION_CERTIFICATE_PASSWORD=
RAAST_BASE_URL=https://api.raast.gov.pk/v1/
STRIPE_BASE_URL=https://api.stripe.com/
PLAID_BASE_URL=https://production.plaid.com/
GOCARDLESS_BASE_URL=https://api.gocardless.com/
BILLPLZ_BASE_URL=https://www.billplz.com/
DUITNOW_BASE_URL=

# AI is optional. Local Ollama is the safe default; use provider=openai only
# after configuring OPENAI_API_KEY through a secure secret store.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
