# Generate a real local .env with: ./scripts/bootstrap-env.sh
AEGISCORE_PORT=8080
AEGISCORE_DEMO_MODE=true
TENANT_ID=

POSTGRES_DB=aegiscore
POSTGRES_USER=aegiscore
POSTGRES_PASSWORD=
REDIS_PASSWORD=

LICENSE_SERVER_URL=https://license.nocturne.systems
LICENSE_HMAC_SECRET=
NOCTURNE_ENCRYPTION_KEY=
NOCTURNE_PQC_KEY_BASE64=
NOCTURNE_JWT_SECRET=
GOVERNANCE_FEEDBACK_KEY_BASE64=

# AI is optional. Local Ollama is the safe default; use provider=openai only
# after configuring OPENAI_API_KEY through a secure secret store.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
