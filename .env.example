# AegisCore environment registry
# Copy to .env, replace every required/conditional placeholder, and never commit .env.

# Database
DB_DIALECT=postgres                          # optional: postgres|mysql|mssql|oracle (default: postgres)
DB_HOST=db.example.internal                    # string | required unless AEGISCORE_DB_CONNECTION is set
DB_PORT=5432                                  # int | required unless AEGISCORE_DB_CONNECTION is set
DB_NAME=aegiscore                             # string | required unless AEGISCORE_DB_CONNECTION is set
DB_USER=aegiscore_app                         # string | required unless AEGISCORE_DB_CONNECTION is set
DB_PASS=replace-with-database-password         # string | required unless AEGISCORE_DB_CONNECTION is set

# Auth / SSO
SSO_PROVIDER=local                            # string | optional: okta|entra|google|saml|local
SSO_CLIENT_ID=                                # string | conditional: required when SSO_PROVIDER != local
SSO_CLIENT_SECRET=                            # string | conditional: required when SSO_PROVIDER != local
SSO_TENANT_ID=                                # string | conditional: required when SSO_PROVIDER = entra
SSO_CALLBACK_URL=                             # string | conditional: required when SSO_PROVIDER != local

# AI / Helpbot
AI_PROVIDER=ollama                            # string | required: ollama|openai|granite|custom
AI_ENDPOINT=http://host.docker.internal:11434 # string | required
AI_MODEL=qwen2.5:7b                           # string | required
AI_API_KEY=                                   # string | conditional: required when AI_PROVIDER is not ollama/ollama-local

# Security / PQC
PQC_MLKEM_PUBLIC_KEY=replace-with-public-key  # string | required
PQC_MLKEM_PRIVATE_KEY=replace-with-private-key # string | required
PQC_MLDSA_PUBLIC_KEY=replace-with-public-key  # string | required
PQC_MLDSA_PRIVATE_KEY=replace-with-private-key # string | required

# Cloudflare
CF_TURNSTILE_SITE_KEY=                        # string | optional: only when the ingress fronts Cloudflare Turnstile
CF_TURNSTILE_SECRET_KEY=                      # string | optional: verified only when a token and this secret are both present

# App
APP_URL=https://erp.example.edu               # string | required
APP_ENV=Production                            # string | required: Production|Staging|Development
APP_SECRET=replace-with-64-character-secret   # string | required
SESSION_LIFETIME=900                          # int seconds | required
# Generate with: openssl rand -hex 32
AEGISCORE_SETUP_TOKEN=replace-with-64-character-random-token # string | required
AEGISCORE_ENCRYPTION_KEY=replace-with-32-byte-base64-key # string | required

# Runtime compatibility and infrastructure
AEGISCORE_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
AEGISCORE_DEMO_MODE=false
AEGISCORE_SECRET_PROVIDER=FILE
AEGISCORE_INSTALLATION_COMPLETED=false
AEGISCORE_CLOUD_PROVIDER=ONPREMISE
TENANT_ID=00000000-0000-0000-0000-000000000001

# Optional prebuilt images. Leave unset to build from source.
# AEGISCORE_API_IMAGE=ghcr.io/abdulnafaysarmad1/aegiscore-api:recovery-latest
# AEGISCORE_PORTAL_IMAGE=ghcr.io/abdulnafaysarmad1/aegiscore-portal:recovery-latest

# Local container dependencies
POSTGRES_DB=aegiscore
POSTGRES_USER=aegiscore
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_ADMIN_USER=aegiscore_admin
POSTGRES_ADMIN_PASSWORD=replace-with-admin-password
REDIS_PASSWORD=replace-with-redis-password

# Existing AegisCore security and licensing integrations
LICENSE_SERVER_URL=https://license.aegiscore.systems
# Set true to validate the signed licence locally and transmit no heartbeat payload.
LICENSE_OFFLINE_MODE=false

LICENSE_HMAC_SECRET=replace-with-license-hmac-secret
AEGISCORE_PQC_KEY_BASE64=replace-with-legacy-pqc-key
# Development only: production signs access tokens with the RSA pair generated at installation and ignores this.
AEGISCORE_JWT_SECRET=
GOVERNANCE_FEEDBACK_KEY_BASE64=replace-with-governance-key
AEGISCORE_REQUIRE_EDGE_PQC=false
AEGISCORE_EDGE_PQC_PROOF_KEY_BASE64=
AEGISCORE_DATA_PROTECTION_CERTIFICATE_PATH=/run/aegiscore-secrets/data-protection.pfx
AEGISCORE_DATA_PROTECTION_CERTIFICATE_PASSWORD=replace-with-certificate-password
# Optional: institution seal printed on the portal header and generated documents (transcripts, letters).
AEGISCORE_SEAL_URL=

# Payment and messaging integrations
RAAST_BASE_URL=https://api.raast.gov.pk/v1/
STRIPE_BASE_URL=https://api.stripe.com/
PLAID_BASE_URL=https://production.plaid.com/
GOCARDLESS_BASE_URL=https://api.gocardless.com/
BILLPLZ_BASE_URL=https://www.billplz.com/
DUITNOW_BASE_URL=
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USERNAME=mailer@example.edu
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.edu
