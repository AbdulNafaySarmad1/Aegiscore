# -------------------------------------------------------------------
# AegisCore CLOUD demo override
#
# PostgreSQL -> Supabase
# Redis      -> local Docker
# API/Portal -> locally built images
# -------------------------------------------------------------------

services:

  api:
    environment:
      DEPLOYMENT_MODE: cloud
      AEGISCORE_DB_CONNECTION: ${AEGISCORE_DB_CONNECTION:?AEGISCORE_DB_CONNECTION must be set}
      AEGISCORE_REDIS_CONNECTION: redis:6379,password=${REDIS_PASSWORD:?REDIS_PASSWORD must be set}

    # Completely remove inherited postgres/redis dependencies.
    # Redis is started explicitly before API.
    depends_on: !reset {}

    restart: always

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  portal:
    environment:
      DEPLOYMENT_MODE: cloud

    restart: always

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # PostgreSQL is external (Supabase)
  postgres: !reset null

  # Redis is local for the demo
  redis:
    image: redis:7-alpine

    command:
      - redis-server
      - --requirepass
      - ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}
      - --appendonly
      - "no"

    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD must be set}

    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli -a "$${REDIS_PASSWORD}" ping 2>/dev/null | grep -q PONG
      interval: 5s
      timeout: 3s
      retries: 10

    restart: unless-stopped
