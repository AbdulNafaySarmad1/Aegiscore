NOCTURNE_DB_CONNECTION=Host=postgres;Port=5432;Database=nocturne;Username=nocturne;Password=nocturne-local;SslMode=Disable
NOCTURNE_REDIS_CONNECTION=redis:6379
NOCTURNE_STORAGE_PROVIDER=local
NOCTURNE_STORAGE_LOCAL_PATH=/app/storage
NOCTURNE_LICENSE_SERVER_URL=https://license.nocturne.systems
NOCTURNE_ENCRYPTION_KEY=base64-32-byte-key
NOCTURNE_PQC_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
NOCTURNE_JWT_SECRET=replace-with-strong-jwt-secret
Governance__FeedbackEncryptionKeyBase64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ASPNETCORE_URLS=http://+:8080
AEGISCORE_INSTALLATION_COMPLETED=true
Database__AutoMigrate=true
POSTGRES_DB=nocturne
POSTGRES_USER=nocturne
POSTGRES_PASSWORD=nocturne-local
