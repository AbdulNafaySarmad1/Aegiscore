@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>AegisCore</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="min-h-screen bg-gray-50">
            <nav class="bg-white shadow-sm border-b border-gray-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between h-16">
                        <div class="flex items-center gap-4">
                            <span class="text-xl font-bold text-indigo-600">AegisCore</span>
                            <a href="/" class="px-3 py-2 text-sm font-medium text-gray-900 border-b-2 border-indigo-500">Dashboard</a>
                            <a href="/students" class="px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700">Students</a>
                            <a href="/faculty" class="px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700">Faculty</a>
                        </div>
                        <div class="flex items-center gap-3">
                            <AuthorizeView>
                                <span class="text-sm text-gray-500">@context.User.Identity?.Name</span>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            </nav>
            <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white rounded-lg shadow p-6"><h3 class="text-sm font-medium text-gray-500">Active Students</h3><p class="text-3xl font-bold text-gray-900 mt-2">--</p></div>
                    <div class="bg-white rounded-lg shadow p-6"><h3 class="text-sm font-medium text-gray-500">Faculty Members</h3><p class="text-3xl font-bold text-gray-900 mt-2">--</p></div>
                    <div class="bg-white rounded-lg shadow p-6"><h3 class="text-sm font-medium text-gray-500">Courses Active</h3><p class="text-3xl font-bold text-gray-900 mt-2">--</p></div>
                </div>
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h2>
                    <p class="text-gray-500">Connect to the API to view live data. Visit the <a href="https://github.com/aegiscore/aegiscore" class="text-indigo-600 hover:underline" target="_blank">documentation</a> for integration details.</p>
                </div>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="min-h-screen flex items-center justify-center bg-gray-50">
            <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-xl shadow-lg">
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-indigo-600">AegisCore</h1>
                    <p class="mt-2 text-gray-500">University operations portal</p>
                </div>
                <p class="text-center text-gray-600">Sign in to access your dashboard.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

